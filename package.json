{
  "name": "ikomida-notification-service",
  "version": "1.0.18",
  "description": "ikomida notification service",
  "private": true,
  "module": "build/service.js",
  "types": "build/service.d.ts",
  "files": [
    "build"
  ],
  "type": "module",
  "scripts": {
    "service": "node build/service.js",
    "build": "rimraf ./build ./types ./docs && rollup -c",
    "prebuild:types": "rimraf ./types",
    "build:types": "tsc -p ./tsconfig.json --outDir build && api-extractor run",
    "predoc:jsdoc": "rimraf ./docs",
    "docs:jsdoc": "jsdoc -r \"src/**/*.ts\" -R README.md -d ./docs",
    "predoc:typedoc": "rimraf ./docs",
    "docs:typedoc": "typedoc src --out docs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint . --ext .ts --quiet --fix",
    "clean": "rimraf ./build ./types ./docs",
    "local": "yarn glogin && ncu -u && yarn && yarn format && yarn lint && yarn build",
    "glogin": "artifactregistry-auth"
  },
  "author": "Khalid Ait Bellahs",
  "license": "UNLICENSED",
  "dependencies": {
    "@ikomida/shared-backend": "^1.6.11",
    "@ikomida/shared-logics": "^1.3.1",
    "@ikomida/shared-types": "^1.9.9",
    "body-parser": "^1.20.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@firebase/app-types": "0.x",
    "@microsoft/api-extractor": "^7.33.7",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/amqplib": "^0.10.1",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.15",
    "@types/linkify-it": "^3.0.2",
    "@types/luxon": "^3.2.0",
    "@types/node": "^18.11.18",
    "@types/node-mailjet": "^3.3.9",
    "@types/sequelize": "^4.28.14",
    "@types/sharp": "^0.31.1",
    "@types/uuid": "^9.0.0",
    "@types/validator": "^13.7.10",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "chai": "^4.3.7",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "google-artifactregistry-auth": "^3.0.2",
    "jsdoc": "^4.0.0",
    "linkify-it": "^4.0.1",
    "mocha": "^10.2.0",
    "prettier": "^2.8.2",
    "rimraf": "^3.0.2",
    "rollup": "^3.9.1",
    "rollup-plugin-auto-external": "^2.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.4.1",
    "typedoc": "^0.23.24",
    "typescript": "^4.9.4"
  }
}